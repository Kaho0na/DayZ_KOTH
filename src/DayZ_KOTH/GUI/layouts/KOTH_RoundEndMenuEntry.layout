FrameWidgetClass VoteEntryRoot {
 ignorepointer 0
 size 1 0.04
 halign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  ButtonWidgetClass vote_button {
   ignorepointer 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Default
   {
    PanelWidgetClass background {
     ignorepointer 1
     color 0.3922 0.3922 0.3922 0.3922
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style blank
    }
    TextWidgetClass ZoneNameText {
     ignorepointer 1
     position 0.02 0
     size 0.6 1
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "Zone Name"
     font "gui/fonts/metron"
     "exact text" 1
     "exact text size" 24
     "size to text h" 0
     "size to text v" 0
     "text halign" left
     "text valign" center
     scriptclass "ViewBinding"
     {
      ScriptParamsClass {
       Binding_Name "ZoneName"
      }
     }
    }
    TextWidgetClass VoteCountText {
     ignorepointer 1
     position 0 0
     size 0.35 1
     halign right_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "0 votes"
     font "gui/fonts/metron"
     "exact text" 1
     "exact text size" 20
     "size to text h" 0
     "size to text v" 0
     "text halign" right
     "text valign" center
     scriptclass "ViewBinding"
     {
      ScriptParamsClass {
       Binding_Name "VoteCount"
      }
     }
    }
   }
  }
 }
}