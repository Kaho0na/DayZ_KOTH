FrameWidgetClass TeamSelectionMenu {
 ignorepointer 1
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 scriptclass "KOTHTeamMenuController"
 {
  ImageWidgetClass Background {
   visible 1
   ignorepointer 1
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   imageTexture ""
   mode opaque
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  PanelWidgetClass Panel {
   inheritalpha 0
   ignorepointer 1
   position 0.0008 0
   size 0.95 0.95
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   draggable 0
   style blank
   {
    ButtonWidgetClass East {
     color 0 0 0 0.7059
     position 0.13 0.17
     size 0.12 0.06
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     scriptclass "ViewBinding"
     style DayZDefaultButton
     {
      TextWidgetClass SpawnEast {
       ignorepointer 1
       color 0.8627 0.8627 0.8627 1
       position 0 0
       size 1 1
       halign center_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "JOIN EAST"
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "size to text h" 0
       "text halign" center
       "text valign" center
      }
     }
    }
    ButtonWidgetClass West {
     color 0 0 0 0.7059
     position -0.13 0.17
     size 0.12 0.06
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     scriptclass "ViewBinding"
     style DayZDefaultButton
     {
      TextWidgetClass SpawnWest {
       ignorepointer 1
       color 0.8627 0.8627 0.8627 1
       position 0 0
       size 1 1
       halign center_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "JOIN WEST"
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "size to text h" 0
       "text halign" center
       "text valign" center
      }
     }
    }
   }
  }
 }
}