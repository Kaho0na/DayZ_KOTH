FrameWidgetClass KOTH_ClothingShopMenu {
 ignorepointer 1
 color 0.0902 0.0902 0.0902 1
 size 1 1
 halign center_ref
 valign center_ref
 hexactsize 0
 vexactsize 0
scriptclass "KOTH_ClothingShopMenuController"
 {
  PanelWidgetClass MainPanel {
   ignorepointer 0
   color 0.1294 0.1294 0.1294 1
   position 0 0
   size 0.9 0.85
   halign center_ref
   valign center_ref
   hexactsize 0
   vexactsize 0
   style Outline
   "no focus" 0
   {
    PanelWidgetClass HeaderPanel {
     ignorepointer 1
     color 0.1765 0.1765 0.1765 1
     position 0 0
     size 1 0.08
     halign center_ref
     valign top_ref
     hexactsize 0
     vexactsize 0
     style Outline
     {
      TextWidgetClass HeaderText {
       ignorepointer 1
       position 0 0
       size 0.6 1
       halign left_ref
       valign center_ref
       hexactsize 0
       vexactsize 0
       text "CLOTHING SHOP"
       font "gui/fonts/Metron"
       "text halign" left
       "text valign" center
      }
      TextWidgetClass PlayerLevel {
       ignorepointer 1
       position 0 0
       size 0.15 1
       halign center_ref
       valign center_ref
       hexactsize 0
       vexactsize 0
       text "{PlayerLevel}"
       font "gui/fonts/Metron"
       "text halign" center
       "text valign" center
      }
      TextWidgetClass EquipCooldown {
       ignorepointer 1
       position 0 0
       size 0.2 1
       halign right_ref
       valign center_ref
       hexactsize 0
       vexactsize 0
       text "{EquipCooldown}"
       font "gui/fonts/Metron"
       "text halign" right
       "text valign" center
      }
     }
    }
    ScrollWidgetClass LoadoutScroll {
     ignorepointer 0
     color 0.1294 0.1294 0.1294 1
     position 0 0.09
     size 1 0.82
     halign center_ref
     valign top_ref
     hexactsize 0
     vexactsize 0
     style Default
     hscrollbar 1
     vscrollbar 0
     {
      WrapSpacerWidgetClass LoadoutListWrapper {
       ignorepointer 0
       clipchildren 0
       color 0.1294 0.1294 0.1294 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactsize 0
       vexactsize 0
       style Default
       Padding 20
       Margin 20
       "Size To Content H" 1
       "Size To Content V" 0
      }
     }
    }
    ButtonWidgetClass CloseButton {
     ignorepointer 0
     position 0.01 0.01
     size 0.2 0.06
     valign bottom_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Default
     text "CLOSE"
     font "gui/fonts/metron"
     "text color" 1 1 1 1
    }
   }
  }
 }
}
