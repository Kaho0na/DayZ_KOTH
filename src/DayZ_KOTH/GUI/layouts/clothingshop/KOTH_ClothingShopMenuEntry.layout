PanelWidgetClass LoadoutEntry {
 ignorepointer 0
 color 0.1765 0.1765 0.1765 1
 position 0 0
 size 400 600
 halign left_ref
 valign top_ref
 hexactsize 1
 vexactsize 1
 style Outline
 {
  PlayerPreviewWidgetClass LoadoutPreview {
   ignorepointer 1
   color 1 1 1 1
   position 0 0
   size 380 450
   halign center_ref
   valign top_ref
   hexactsize 1
   vexactsize 1
  }
  TextWidgetClass LoadoutName {
   ignorepointer 1
   position 0 0
   size 380 40
   halign center_ref
   valign top_ref
   hexactsize 1
   vexactsize 1
   text "Loadout Name"
   font "gui/fonts/Metron"
   "text halign" center
   "text valign" center
  }
  ButtonWidgetClass EquipButton {
   ignorepointer 0
   position 0 0.9
   size 280 50
   halign center_ref
   valign top_ref
   hexactsize 1
   vexactsize 1
   style Default
   text "EQUIP"
   font "gui/fonts/Metron"
   {
    TextWidgetClass EquipButtonText {
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactsize 0
     vexactsize 0
     text "EQUIP"
     font "gui/fonts/Metron"
     "text halign" center
     "text valign" center
    }
   }
  }
  TextWidgetClass LockedText {
   ignorepointer 1
   position 0 0.77
   size 380 50
   halign center_ref
   valign top_ref
   hexactsize 1
   vexactsize 1
   text "REQUIRE LVL X"
   font "gui/fonts/Metron"
   "exact text" 0
   "text halign" center
   "text valign" center
  }
 }
}